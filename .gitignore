# ============================================================
# .gitignore — FrontendTallerNarbus / ProtoNeumaticos
# ============================================================

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
replay_pid*.log

# ── Build outputs ───────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Dependencias ────────────────────────────────────────────
node_modules/

# ── Variables de entorno y SECRETOS ─────────────────────────
# .env.example SÍ va a git (sin valores reales).
# TODO lo demás NO.
.env
.env.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.development.local
.env.test.local
.env.*.local
*.local

# ── Editor y sistema operativo ──────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Android / Capacitor (build nativo) ──────────────────────
# El directorio android se genera con `npx cap add android`
# No tiene sentido trackearlo en el repo frontend web.
# Descomentar si se decide versionar la app nativa:
# android/

# ── Overrides locales de Docker ──────────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ── Coverage y tests ─────────────────────────────────────────
coverage/
.nyc_output/

# ── Capacitor ───────────────────────────────────────────────
.capacitor/

# ── TypeScript cache ─────────────────────────────────────────
*.tsbuildinfo
