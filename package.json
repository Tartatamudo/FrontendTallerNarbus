{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "preview": "vite preview",
    "docker:build": "docker build --build-arg VITE_API_BASE_URL=http://localhost:8000 -t narbus-frontend:test .",
    "docker:run": "docker run -d --rm --name narbus-frontend-container -p 8080:80 narbus-frontend:test",
    "docker:stop": "docker stop narbus-frontend-container",
    "test:docker": "playwright test",
    "test:docker:report": "playwright show-report"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "axios": "^1.19.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.1"
  }
}
