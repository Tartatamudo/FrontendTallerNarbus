# ============================================================
# .env.example — FrontendTallerNarbus
#
# ESTE ARCHIVO SÍ VA A GIT — no contiene valores reales.
# Documenta todas las variables de entorno requeridas.
#
# Para desarrollo local:
#   cp .env.example .env
#   # Editar .env con los valores reales (NO commitear)
#
# Para producción (CI/CD):
#   Configurar como secretos en GitHub Actions / GitLab CI / servidor.
#   docker build --build-arg VITE_API_BASE_URL=<valor_real> ...
# ============================================================

# ── Backend API ─────────────────────────────────────────────
# URL BASE del backend FastAPI (incluye protocolo y host, SIN barra final)
# Ejemplo dev local:   http://127.0.0.1:8000
# Ejemplo producción:  https://api.narbus.cl
VITE_API_BASE_URL=http://127.0.0.1:8000

# Alias del backend (legacy, usado por imageUrl.ts y apiClient.ts como fallback)
# Mantener igual que VITE_API_BASE_URL
VITE_API_URL=http://127.0.0.1:8000/api/v1/formularioNeumatico
