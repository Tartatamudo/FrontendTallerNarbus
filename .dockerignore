# ============================================================
# .dockerignore — FrontendTallerNarbus
# Excluye archivos innecesarios del contexto de build Docker.
# Reduce el tamaño del contexto y evita filtrar secretos.
# ============================================================

# ── Dependencias (se instalan dentro del contenedor) ────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build output (se regenera en el Dockerfile) ─────────────
dist/
dist-ssr/

# ── Variables de entorno y SECRETOS ─────────────────────────
# NUNCA enviar .env con valores reales al contexto de Docker
.env
.env.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.*.local

# ── Android (Capacitor) — solo para builds móviles nativas ──
android/
ios/
capacitor.config.ts

# ── Git ─────────────────────────────────────────────────────
.git/
.gitignore

# ── Trazabilidad y documentación interna ────────────────────
trazabilidad/
*.md
endpoints_documentacion.md

# ── Editor y sistema operativo ──────────────────────────────
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
replay_pid*.log

# ── Tests ────────────────────────────────────────────────────
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# ── Docker (evitar recursión) ────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── CI/CD (no necesarios en el bundle) ───────────────────────
cloudbuild.yaml
.github/
